# =============================================================================
# Smart Traffic AI — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is already listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=sta_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=smart_traffic_ai
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend API (FastAPI)
# -----------------------------------------------------------------------------
API_PORT=8000

# JWT — used to sign/verify access tokens for authenticated users
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_64_char_random_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# RTO / VAHAN Vehicle Registration API
# -----------------------------------------------------------------------------
# This system integrates with an AUTHORIZED third-party VAHAN/RTO data
# provider to retrieve registered-owner details for a detected plate number.
# Direct scraping of the government VAHAN portal is not authorized — use a
# licensed data-provider API (e.g. a government-approved aggregator) and
# supply its base URL and API key here.
VAHAN_API_BASE_URL=https://api.your-authorized-vahan-provider.example
VAHAN_API_KEY=replace_with_provider_api_key

# -----------------------------------------------------------------------------
# SMS Notification Provider (e.g. Twilio, MSG91, AWS SNS)
# -----------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=replace_with_sms_provider_key
SMS_PROVIDER_SENDER_ID=STAAI

# -----------------------------------------------------------------------------
# AI Inference Service
# -----------------------------------------------------------------------------
# "cpu" for Raspberry Pi / no-GPU environments, "cuda" if a GPU is available
INFERENCE_DEVICE=cpu

# -----------------------------------------------------------------------------
# Frontend (React + Vite)
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
